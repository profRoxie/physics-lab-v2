         label=f'Linear Fit (Acceleration = {slope:.2f} m/s², R² = {r_value**2:.2f})')

plt.xlabel('Time (s)')
plt.ylabel('Velocity (m/s)')
plt.title('Velocity vs. Time with Linear Regression')
plt.grid(True)
plt.legend()
plt.show()

