# Define the x and y data for regression
x_data = df_simulated_csv['Time (s)']
y_data = df_simulated_csv['Velocity (m/s)']

# Perform linear regression
slope, intercept, r_value, p_value, std_err = linregress(x_data, y_data)

# Print the results
print("--- Linear Regression Results for Velocity vs. Time ---")
print(f"Calculated Slope (Acceleration): {slope:.4f} m/s²")
print(f"Calculated Y-intercept (Initial Velocity): {intercept:.4f} m/s")
